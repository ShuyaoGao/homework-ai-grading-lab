# 复制为 .env 后按需填写（.env 已 gitignore，切勿提交 key）。全部留空 = mock 模式，离线可跑。

# ---------- 云端模型（任选；填了会被 auto 自动选用）----------
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5          # 可选 claude-opus-5-5
# CLAUDE_OCR_MODEL=                       # 留空同 CLAUDE_MODEL
# CLAUDE_EFFORT=medium                    # low / medium / high
# CLAUDE_FALLBACKS=true                   # 服务端拒答回退（仅 Claude API 直连支持）
# DASHSCOPE_API_KEY=                      # 通义（OpenAI 兼容），默认识别 qwen-vl-max、评分 qwen-plus

# ---------- OpenAI 兼容接口（服务器 vLLM 本地模型等）----------
# OPENAI_COMPAT_BASE_URL=http://<服务器IP>:8101/v1
# OPENAI_COMPAT_OCR_BASE_URL=              # 识别/评分分别部署时用
# OPENAI_COMPAT_GRADER_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_OCR_MODEL=qwen-vl
# OPENAI_COMPAT_GRADER_MODEL=qwen-grader
# OPENAI_COMPAT_IS_LOCAL=true             # 本地部署：不算云端，不需要监护人 cloud_ai 同意
# OPENAI_COMPAT_JSON_MODE=json_schema     # none / json_object（DashScope）/ json_schema（vLLM）

# ---------- provider 选择 ----------
# OCR_PROVIDER=auto                       # auto / mock / claude / openai_compat / paddle
# GRADER_PROVIDER=auto                    # auto / mock / claude / openai_compat

# ---------- 系统 ----------
# EDU_DATA_DIR=./data
# EDU_SECRET_KEY=                         # 留空则首次启动生成到 data/secret.key
# EDU_TOKEN_EXPIRE_MINUTES=720
# ALLOW_CLOUD_PROVIDERS=true              # false = 一律不用云端模型
# EDU_RETENTION_DAYS=365                  # 作业图片保留天数
# EDU_SHOW_AI_BEFORE_REVIEW=true          # false = 家长/学生在教师复核前看不到分数
# EDU_MAX_UPLOAD_MB=15
# EDU_MAX_PAGES=10
